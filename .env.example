PORT=3000
CINDER_BIND=127.0.0.1
MAX_FILE_MB=100
MAX_PARTICIPANTS=50
MAX_CONCURRENT_UPLOADS=4
MAX_FILES=200
MAX_ROOM_STORAGE_MB=1024
ROOM_TTL_MINUTES=180
SCREEN_MAX_MINUTES=5
CINDER_ROUTES=both
CINDER_RELAY=rust

# Group media. `npm run room` loads this file automatically. Leave all values
# blank to start an installed local livekit-server with one-session credentials.
# Public browser invitations require a reachable WSS/UDP LiveKit deployment.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_CONFIG=
CINDER_START_LIVEKIT=false
