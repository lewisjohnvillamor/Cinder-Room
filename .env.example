PORT=3000
CINDER_BIND=127.0.0.1
MAX_FILE_MB=100
MAX_PARTICIPANTS=50
MAX_CONCURRENT_UPLOADS=4
MAX_FILES=200
MAX_ROOM_STORAGE_MB=1024
ROOM_TTL_MINUTES=180
SCREEN_MAX_MINUTES=5
CINDER_ROUTES=both
CINDER_RELAY=rust
CINDER_AUTO_INSTALL_CLOUDFLARED=true

# Group media. `npm run room` loads this file automatically.
#
# LiveKit Cloud (your setup): set LIVEKIT_URL + API key + secret. Leave
# LIVEKIT_CONFIG empty and CINDER_START_LIVEKIT=false.
#
# Self-hosted livekit-server on this machine: leave LIVEKIT_URL blank and
# install livekit-server — Cinder auto-starts it with ephemeral credentials.
#
# Self-hosted livekit-server you manage separately: set LIVEKIT_URL + keys,
# leave CINDER_START_LIVEKIT=false.
#
# Full VPS deployment (Cinder starts LiveKit for you): set all four values
# and CINDER_START_LIVEKIT=true with a path to a livekit.yaml file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_CONFIG=
CINDER_START_LIVEKIT=false
